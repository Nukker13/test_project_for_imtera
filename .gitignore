# Окружение
.env
.env.*
!.env.example
!.env.prod.example

# Приватные ключи. Правило намеренно широкое: скачанные из панели хостинга
# ключи легко забыть в папке проекта, а цена ошибки — утечка доступа к серверу.
*.key
*.pem
id_rsa*
id_ed25519*
!*.pub

# Зависимости и артефакты сборки
backend/vendor/
frontend/node_modules/
frontend/dist/
parser/__pycache__/
parser/**/__pycache__/
parser/.pytest_cache/

# Эталон подписи записывается парсером на первом успешном прогоне
parser/fixtures/real_request.json

# IDE и ОС
.idea/
.DS_Store

# ТЗ не публикуем — файл остаётся локально
spec.md
