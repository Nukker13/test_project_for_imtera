# Адрес стенда без схемы. Либо свой домен, либо sslip.io-имя, которое
# резолвится в IP сервера: например 130-61-45-12.sslip.io для IP 130.61.45.12.
# На него Let's Encrypt выдаёт нормальный сертификат, свой домен не обязателен.
SITE_ADDRESS=

# Сгенерировать один раз и больше не менять (смена разлогинит всех).
# Без Docker: контейнер backend не стартует с пустым APP_KEY, поэтому
# сгенерировать ключ его же средствами нельзя — получается замкнутый круг.
# Команда ниже делает ровно то же самое, что artisan key:generate:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=

DB_DATABASE=imtera
DB_USERNAME=imtera
DB_PASSWORD=

# Реквизиты для проверяющего — укажите их в README.
SEED_USER_EMAIL=admin@imtera.test
SEED_USER_PASSWORD=

PARSER_TIMEOUT=600
YANDEX_MAX_PAGES=12
YANDEX_PAGE_SIZE=50
