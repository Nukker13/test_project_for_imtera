APP_NAME="Imtera Reviews"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=imtera
DB_USERNAME=imtera
DB_PASSWORD=secret

# Сессии живут в БД: воркер и веб-процесс — разные контейнеры, файловый драйвер
# между ними не разделяется.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:5173

CACHE_STORE=redis
QUEUE_CONNECTION=redis
# predis — чистый PHP-клиент, не требует расширения phpredis в образе.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379

# Python-сервис с парсером. Таймаут в секундах: один прогон — это минуты
# работы, десяток запросов к Яндексу с паузами между ними.
PARSER_URL=http://python-service:8001
PARSER_TIMEOUT=600
YANDEX_MAX_PAGES=12

# Пользователь, под которым выполняется вход (регистрации в проекте нет).
SEED_USER_EMAIL=admin@imtera.test
SEED_USER_PASSWORD=password
