# Продакшен-образ backend.
#
# Отличие от dev-образа одно, но принципиальное: php-fpm вместо встроенного
# `php -S`. Встроенный сервер однопоточный и обрабатывает запросы строго по
# одному — на публичном стенде это значит, что поллинг статуса прогона заблокирует
# отдачу всего остального. Перед fpm стоит Caddy, он же отдаёт статику и держит TLS.
FROM php:8.4-fpm

RUN apt-get update && apt-get install -y --no-install-recommends \
        git unzip libpq-dev libzip-dev libicu-dev \
    && docker-php-ext-install pdo_pgsql pgsql zip intl opcache \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY composer.json composer.lock ./
# Без dev-зависимостей: на проде они не нужны и только увеличивают образ.
RUN composer install --no-interaction --no-scripts --no-autoloader \
        --prefer-dist --no-dev

COPY . .
RUN composer dump-autoload --optimize --no-dev

COPY docker-entrypoint.prod.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    && chown -R www-data:www-data storage bootstrap/cache

# Кэш опкодов: на проде файлы не меняются, перепроверять их на каждый запрос незачем.
RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.max_accelerated_files=10000'; \
    } > /usr/local/etc/php/conf.d/opcache.ini

EXPOSE 9000

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["php-fpm"]
